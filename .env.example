# --- Server ---
PORT=3000
NODE_ENV=development

# Public site URL (used for canonical links / emails)
SITE_URL=http://localhost:3000

# Comma-separated list of extra allowed CORS origins (same-origin is always allowed)
CORS_ORIGINS=

# --- Admin area (/admin) ---
# The FIRST admin account is created from these when the site starts with no users.
# After it exists you can delete ADMIN_PASSWORD from this file. Use 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: 32+ random characters used to sign login cookies. If empty, one is generated
# and stored in STORAGE_DIR (.session-secret). Set it if you run more than one instance.
SESSION_SECRET=
# Behind a reverse proxy (nginx, Caddy, Cloudflare)? Set to the number of proxies (usually 1)
# so secure cookies and rate limits work correctly.
TRUST_PROXY=

# --- Images ---
# Set to "true" after running `npm run images:download` to serve photos locally
VITE_LOCAL_IMAGES=false

# --- Optional email notifications (app works fully without these) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Geaworth Properties <no-reply@geaworthproperties.com>"
# Every website form (contact, valuation, newsletter) is emailed here.
NOTIFICATION_EMAIL=info@geaworthproperties.com
