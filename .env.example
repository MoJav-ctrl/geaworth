PORT=3000
NODE_ENV=development

SITE_URL=http://localhost:3000

CORS_ORIGINS=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: 32+ random characters used to sign login cookies. If empty, one is generated
# and stored in STORAGE_DIR (.session-secret). Set it if you run more than one instance.
SESSION_SECRET=

# --- Images ---
# Set to "true" after running `npm run images:download` to serve photos locally
VITE_LOCAL_IMAGES=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Geaworth Properties <no-reply@geaworthproperties.com>"
# Every website form (contact, valuation, newsletter) is emailed here.
NOTIFICATION_EMAIL=info@geaworthproperties.com
