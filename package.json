{
  "name": "geaworth-properties",
  "version": "1.0.0",
  "private": true,
  "description": "Geaworth Properties Limited (RC 1498320) – Prime Lagos real estate bureau. React + Vite client, Express API.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "lint": "npm run typecheck && node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "node --test \"client/src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "icons:sync": "node scripts/sync-icons.mjs",
    "images:download": "node scripts/download-images.mjs",
    "admin:password": "tsx server/scripts/set-password.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/karla": "^5.2.0",
    "@fontsource-variable/playfair-display": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "typescript": "^7.0.2"
  }
}
